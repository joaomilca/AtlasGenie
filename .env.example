# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key for Maps JS, Places & Routes.
VITE_GOOGLE_MAPS_API_KEY=""

# RESEND_API_KEY: Optional API key for sending departure reminder emails via Resend.
RESEND_API_KEY=""

